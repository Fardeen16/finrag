# RunPod console settings for this project. Not loaded by the app.
# LLM:  finrag-qwen-7b-awq   id=5fcu4xq44fq6pu
#       OpenAI URL: https://api.runpod.ai/v2/5fcu4xq44fq6pu/openai/v1
# Rerank: finrag-rerank      id=psdaxhe69eemly
#       Base URL: https://api.runpod.ai/v2/psdaxhe69eemly
# Image: public.ecr.aws/d0q0n3h2/finrag-rerank:v1.0.0
# Create the endpoints, then put the URLs + API key in the repo-root .env.

# Hub: Serverless → Deploy vLLM worker (runpod-workers/worker-vllm)
# GPU: 16 GB class (A4000 / RTX 4000 / T4). 7B AWQ does not need 24 GB.
# Min workers: 0          ← scale to zero. Never set this to 1.
# Max workers: 1
# Idle timeout: 120 s     ← one FinRAG question is several LLM calls with
#                           CPU work (embed/rerank) between them. 5 s idle
#                           would kill the GPU mid-question and cold-start
#                           every call.
# FlashBoot: on if offered
# Container disk: 20 GB
# Rerank worker: custom cu128 CrossEncoder (not Hub Infinity).
# GPU: AMPERE_16 ($0.58/hr). CUDA 12.8/13.0. Min 0, max 1, idle 60 s.
# MODEL_NAMES=cross-encoder/ms-marco-MiniLM-L-6-v2

MODEL_NAME=Qwen/Qwen2.5-7B-Instruct-AWQ
QUANTIZATION=awq
MAX_MODEL_LEN=4096
GPU_MEMORY_UTILIZATION=0.90
DTYPE=half
ENABLE_AUTO_TOOL_CHOICE=true
TOOL_CALL_PARSER=hermes
OPENAI_SERVED_MODEL_NAME_OVERRIDE=Qwen/Qwen2.5-7B-Instruct-AWQ
