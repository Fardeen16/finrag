# --- Inference ---------------------------------------------------------------
# Local vLLM:
#   VLLM_BASE_URL=http://localhost:8000/v1
#   VLLM_API_KEY=EMPTY
# RunPod Serverless (scale-to-zero). Replace ENDPOINT_ID and the API key:
#   VLLM_BASE_URL=https://api.runpod.ai/v2/ENDPOINT_ID/openai/v1
#   VLLM_API_KEY=your_runpod_api_key
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ

# mock = canned SSE traces (no GPU). live = LangGraph + vLLM + Qdrant.
AGENT_MODE=mock

# --- Embeddings --------------------------------------------------------------
# 'local' is the default. 'google' only if you re-index with text-embedding-004.
EMBEDDING_PROVIDER=local

# Only needed while EMBEDDING_PROVIDER=google.
GOOGLE_API_KEY=

# --- Stores ------------------------------------------------------------------
# Leave QDRANT_URL empty to use the embedded on-disk store at data/qdrant_db.
# Set it to a Qdrant Cloud URL before deploying — embedded mode cannot run on
# Fargate (ephemeral disk, cannot share a lock across tasks).
QDRANT_URL=
QDRANT_API_KEY=
